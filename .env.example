# Copia questo file come `.env` nella stessa cartella del docker-compose.yml.
# Serve solo per personalizzare: senza .env l'app parte comunque con i valori di default.
# Su Synology DSM: vedi docs/SYNOLOGY-DSM.md

# Porta con cui apri l'app dal browser. Cambiala se 49273 è già occupata sul NAS.
WEB_PORT=49273

# L'indirizzo con cui raggiungi davvero l'app. Finisce nei link delle email di verifica e di
# recupero password e nel redirect OAuth Microsoft: se resta su localhost quei link non funzionano
# per nessun altro. Esempio NAS in LAN: http://192.168.1.50:49273
PUBLIC_APP_URL=http://localhost:49273
PUBLIC_SITE_URL=https://emboxa.eu

# true SOLO se apri l'app in HTTPS (reverse proxy DSM, dominio, certificato).
# Con true su un semplice http:// il browser scarta il cookie e il login non va a buon fine.
COOKIE_SECURE=false

# Utente con cui gira l'app. Vuoto = adotta il proprietario della cartella ./data, che su un NAS
# è l'account che ha copiato i file: è quello che serve nella quasi totalità dei casi.
PUID=
PGID=

# Creano il primo amministratore SOLO su un'installazione vuota.
# Se stai portando con te una cartella data/ che ha già i suoi utenti, lasciali vuoti.
# Dopo il primo accesso svuotali e riavvia: l'utente resta nel database.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Vuoto = usa il database già presente in ./data/db. Da toccare solo per casi particolari.
DATABASE_URL=
DATA_DIR=/data
SESSION_SECRET_FILE=/data/secrets/session.key
ENCRYPTION_KEY_FILE=/data/secrets/fernet.key
APP_SECRET=
ENCRYPTION_KEY=

LOG_LEVEL=INFO
TZ=Europe/Rome

# Microsoft OAuth, per collegare Outlook/Hotmail/Live/Microsoft 365 senza password IMAP.
# SMTP e Telegram non stanno qui: si configurano da /admin e restano nel database.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
