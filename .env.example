# Porta Web distinta dalla self-hosted; cambiarla se occupata.
WEB_PORT=49273
PUBLIC_APP_URL=https://emboxa.eu
GITHUB_REPOSITORY_URL=https://github.com/Mission-F/Emboxa
APP_SECRET=
ENCRYPTION_KEY=

# In produzione dietro HTTPS impostare true.
COOKIE_SECURE=true

# Percorsi interni al volume persistente (normalmente non vanno cambiati).
DATA_DIR=/data
DATABASE_URL=sqlite:////data/db/emboxa-web.db
SESSION_SECRET_FILE=/data/secrets/session.key
ENCRYPTION_KEY_FILE=/data/secrets/fernet.key

# Solo bootstrap del primo amministratore. Dopo il primo accesso usare /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

LOG_LEVEL=INFO
TZ=Europe/Rome
